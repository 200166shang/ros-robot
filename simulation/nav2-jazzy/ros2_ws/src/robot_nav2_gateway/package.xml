<?xml version="1.0"?>
<package format="3">
  <name>robot_nav2_gateway</name>
  <version>0.1.0</version>
  <description>Mac-hosted HTTP/UI gateway for the isolated Nav2 Jazzy loopback simulator.</description>
  <maintainer email="robot@example.invalid">ros-robot maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_minimal_tb3_sim</exec_depend>
  <exec_depend>nav2_loopback_sim</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
